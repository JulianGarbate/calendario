{
  "functions": {
    "api/frases/fondo.js": {
      "includeFiles": "fonts/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/frases",
      "destination": "/api/frases"
    },
    {
      "source": "/frases/:id",
      "destination": "/api/frases/:id"
    }
  ]
}
